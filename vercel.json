{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/((?!maintenance|images|favicon|robots).*)",
      "destination": "/maintenance.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
