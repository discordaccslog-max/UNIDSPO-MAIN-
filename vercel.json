{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/((?!maintenance|images/|favicon|robots.txt).*)",
      "destination": "/maintenance.html",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
